.venv/
__pycache__/
*.pyc
.pytest_cache/
build/
dist/
*.egg-info/
config/.env
# Holds the same secrets config/.env did, until you delete it.
config/.env.migrated
config/preferences.json
config/google_credentials.json
config/google_token.json
config/ai_chat_learnings_state.json
config/.interpreter_id
config/*.lock
config/*.corrupt-*
logs/*.log
logs/*.log.bak
# Not covered by the two rules above: *.log* does not match .jsonl, and the
# config/*.lock rule does not reach logs/.
logs/usage.jsonl
logs/*.lock
.DS_Store
.claude/
.codex/
scratchpad
# Working plans and audits. They quote real paths, real accounts, and work not
# done yet, so they stay on disk and out of the history.
docs/reviews/
