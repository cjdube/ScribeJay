# The legacy settings file. Still read, and still the HIGHEST-priority layer —
# an entry here overrides ~/.scribejay/config.json and the Keychain both.
#
# New installs do not need it: every key below has a row in
# scribejay/core/schema.py, non-secrets live in ~/.scribejay/config.json, and
# the seven secrets live in the macOS Keychain. See docs/configuration.md.
#
# Existing install? Run `python -m scribejay.migrate` — it moves everything and
# renames config/.env out of the way. Keep this file only to pin a value for one
# machine or one run.
#
# config/.env is gitignored — never commit real secrets.

# --- Google (calendar read/write, Gmail sent-mail read) ---
# OAuth client secret JSON downloaded from Google Cloud Console.
# A relative path still resolves against a source checkout if the file is
# there; the default is absolute because an installed copy has no checkout.
# GOOGLE_CREDENTIALS_PATH=   # defaults to ~/.scribejay/google_credentials.json
# Where the OAuth token is cached after the first browser consent.
# GOOGLE_TOKEN_PATH=   # defaults to ~/.scribejay/google_token.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_HTTP_TIMEOUT_S=30
# Port for the local OAuth callback during the one-time consent flow.
# 0 picks any free port. Pin one only if you registered a fixed
# redirect URI in the Google Cloud console.
GOOGLE_OAUTH_PORT=0

# --- Ollama (local model, default backend) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=3072
OLLAMA_TIMEOUT=300
OLLAMA_WARM_TIMEOUT=600
OLLAMA_KEEP_ALIVE=30m

# --- Gemini (opt-in cloud backend — see docs/llm-backend.md) ---
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# SCRIBEJAY_LLM_BACKEND=ollama
# SCRIBEJAY_<TASK_KEY>_BACKEND=gemini   # per-task override, e.g. SCRIBEJAY_CALENDAR_COLORIZER_BACKEND
# SCRIBEJAY_GEMINI_MODEL=gemini-2.5-flash
# SCRIBEJAY_GEMINI_MAX_OUTPUT_TOKENS=8192
# SCRIBEJAY_GEMINI_THINKING_BUDGET=0

# --- OpenRouter (opt-in cloud backend — see docs/llm-backend.md) ---
# One key for every frontier model. Key: https://openrouter.ai/keys
# BILLED PER TOKEN. The default model below is a paid frontier model, and the
# jobs run unattended on a schedule. A ':free' slug or an @preset/ slug costs
# nothing; https://openrouter.ai/models prices every one.
# OPENROUTER_API_KEY=
# SCRIBEJAY_LLM_BACKEND=openrouter
# Model slugs: https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_MAX_OUTPUT_TOKENS=8192

# --- ntfy (failure push alerts — see docs/ntfy-setup.md) ---
# Leave unset to run with push off.
# NTFY_URL=http://<mac-mini-tailscale-name>:2586/scribejay-alerts
# NTFY_TOKEN=tk_...

# --- Where the day's page gets written ---
LEARNINGS_DIR=~/Documents/ScribeJay
# Vault-write-failure fallback recipient (scribejay/sinks/email.py).
BRIEF_TO_EMAIL=you@example.com

# --- Sources ---
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REFRESH_TOKEN=   # run `.venv/bin/python -m scribejay.sources.strava --authorize` to get one
# CLICKUP_API_TOKEN=
SCRIBEJAY_GIT_AUTHOR=Your Name
PROJECTS_DIR=~/Projects
CORRESPONDENCE_DIR=~/Documents/ScribeJay/correspondence
# Session transcript sources for ai_chat_learnings / claude_time_blocks.
# CLAUDE_CONFIG_DIR=~/.claude
# CODEX_HOME=~/.codex
# SCRIBEJAY_GEMINI_CHATS_DIR=~/Documents/ScribeJay/gemini_inbox
# Sessions whose working directory is inside this folder are skipped: a
# headless agent's build worktrees are its work, not yours.
# SCRIBEJAY_EXCLUDED_SESSIONS_DIR=~/Projects/.wren-builds

# --- Everything else ---
TIMEZONE=America/New_York
# SCRIBEJAY_LOGS_DIR=   # defaults to ~/.scribejay/logs
AI_CHAT_LEARNINGS_MAX_CHARS=12000
SCRIBEJAY_SESSION_BLOCK_GAP_MINUTES=20
SCRIBEJAY_SESSION_BLOCK_MIN_MINUTES=10
SCRIBEJAY_SESSION_BLOCK_MAX_CHARS=6000

# --- Which sources to use ---
# Leave every line commented to let ScribeJay decide from what is set up:
# a source with no credentials is off and silent, one with credentials is on.
# Uncomment a line only to overrule that guess.
# SCRIBEJAY_FEATURE_CHROME=1
# SCRIBEJAY_FEATURE_TRANSCRIPTS=1
# SCRIBEJAY_FEATURE_GIT=1
# SCRIBEJAY_FEATURE_GOOGLE_CALENDAR=1
# SCRIBEJAY_FEATURE_GMAIL=1
# SCRIBEJAY_FEATURE_YOUTUBE=1
# SCRIBEJAY_FEATURE_STRAVA=0
# SCRIBEJAY_FEATURE_CLICKUP=0
# SCRIBEJAY_FEATURE_NOTIFY=1
