# The legacy settings file. Still read, and still the HIGHEST-priority layer —
# an entry here overrides ~/.scribejay/config.json and the Keychain both.
#
# New installs do not need it: every key below has a row in
# scribejay/core/schema.py, non-secrets live in ~/.scribejay/config.json, and
# the six secrets live in the macOS Keychain. See docs/configuration.md.
#
# Existing install? Run `python -m scribejay.migrate` — it moves everything and
# renames config/.env out of the way. Keep this file only to pin a value for one
# machine or one run.
#
# config/.env is gitignored — never commit real secrets.

# --- Google (calendar read/write, Gmail sent-mail read) ---
# OAuth client secret JSON downloaded from Google Cloud Console.
GOOGLE_CREDENTIALS_PATH=config/google_credentials.json
# Where the OAuth token is cached after the first browser consent.
GOOGLE_TOKEN_PATH=config/google_token.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_HTTP_TIMEOUT_S=30
# Port for the local OAuth callback during the one-time consent flow.
GOOGLE_OAUTH_PORT=8765

# --- Ollama (local model, default backend) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=3072
OLLAMA_TIMEOUT=300
OLLAMA_WARM_TIMEOUT=600
OLLAMA_KEEP_ALIVE=30m

# --- Gemini (opt-in cloud backend — see docs/llm-backend.md) ---
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# SCRIBEJAY_LLM_BACKEND=ollama
# SCRIBEJAY_<TASK_KEY>_BACKEND=gemini   # per-task override, e.g. SCRIBEJAY_CALENDAR_COLORIZER_BACKEND
# SCRIBEJAY_GEMINI_MODEL=gemini-2.5-flash
# SCRIBEJAY_GEMINI_MAX_OUTPUT_TOKENS=8192
# SCRIBEJAY_GEMINI_THINKING_BUDGET=128

# --- ntfy (failure push alerts — see docs/ntfy-setup.md) ---
# Leave unset to run with push off.
# NTFY_URL=http://<mac-mini-tailscale-name>:2586/scribejay-alerts
# NTFY_TOKEN=tk_...

# --- Where the day's page gets written ---
LEARNINGS_DIR=~/Vaults/llm-wiki-learnings
# Vault-write-failure fallback recipient (scribejay/sinks/email.py).
BRIEF_TO_EMAIL=you@example.com

# --- Sources ---
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REFRESH_TOKEN=   # run `.venv/bin/python -m scribejay.sources.strava --authorize` to get one
# CLICKUP_API_TOKEN=
SCRIBEJAY_GIT_AUTHOR=Your Name
PROJECTS_DIR=~/Projects
CORRESPONDENCE_DIR=~/Vaults/llm-wiki-learnings/correspondence
# Session transcript sources for ai_chat_learnings / claude_time_blocks.
# CLAUDE_CONFIG_DIR=~/.claude
# CODEX_HOME=~/.codex
# SCRIBEJAY_GEMINI_CHATS_DIR=~/Gemini-Chats

# --- Everything else ---
TIMEZONE=America/New_York
SCRIBEJAY_LOGS_DIR=logs
AI_CHAT_LEARNINGS_MAX_CHARS=12000
WREN_SESSION_BLOCK_GAP_MINUTES=20
WREN_SESSION_BLOCK_MIN_MINUTES=5
WREN_SESSION_BLOCK_MAX_CHARS=6000
